# PRISM Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Flask
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///machines.db
FLASK_DEBUG=false

# Feature flags (Phase-0 interim — set true only in dev)
ENABLE_DEBUG_ROUTES=false
ENABLE_EMERGENCY_ENDPOINTS=false

# Auth (F3)
ENABLE_AUTH=true

# Gmail SMTP — use a 16-char App Password, NOT your account password
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_MAINTENANCE_TEAM=maintenance-team@example.com
EMAIL_PLANT_MANAGER=plant-manager@example.com
EMAIL_EMERGENCY_RESPONSE=emergency@example.com

# Twilio — get values from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-32-char-auth-token
TWILIO_PHONE_NUMBER=+15550000000
TWILIO_EMERGENCY_CONTACTS=+15550000001,+15550000002,+15550000003
TWILIO_VOICE=alice
TWILIO_LANGUAGE=en-US

# OpenAI (optional — leave empty to use local Ollama or rule-based fallback)
OPENAI_API_KEY=
CHATBOT_USE_OPENAI=false
CHATBOT_USE_LOCAL_AI=true
CHATBOT_LOCAL_MODEL=llama2
